<UserControl x:Class="TwitchDownloaderAvalonia.PageQueue"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:TwitchDownloaderAvalonia.Converters"
             xmlns:loc="using:TwitchDownloaderAvalonia.Localization"
             xmlns:tasks="using:TwitchDownloaderAvalonia"
             Loaded="Page_Loaded">

    <UserControl.Resources>
        <conv:NullToBoolConverter x:Key="NullToBool" />
        <x:Double x:Key="TaskListFontSize">12</x:Double>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="2" BorderThickness="1" BorderBrush="{DynamicResource AppElementBorder}" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="queueList" ItemsSource="{x:Static tasks:PageQueue.TaskList}" Margin="0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="8" Margin="8" Padding="4" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc TaskCancel}" Click="MenuItemCancelTask_Click" IsEnabled="{Binding CanCancel}" Foreground="{DynamicResource AppText}" />
                                        <MenuItem Header="{loc:Loc ContextMenuRemoveTask}" Click="MenuItemRemoveTask_Click" Foreground="{DynamicResource AppText}" />
                                        <MenuItem Header="{loc:Loc TaskRetry}" Click="MenuItemTaskRetry_Click" IsVisible="{Binding CanReinitialize}" Foreground="{DynamicResource AppText}" />
                                        <MenuItem Header="{loc:Loc TaskErrorButton}" Click="MenuItemTaskError_Click" IsVisible="{Binding Exception, Converter={StaticResource NullToBool}}" Foreground="{DynamicResource AppText}" />
                                        <MenuItem Header="{loc:Loc ContextMenuOpenTaskFolder}" Click="MenuItemOpenTaskFolder_Click" Foreground="{DynamicResource AppText}" />
                                        <MenuItem Header="{loc:Loc CopyFolderPathToClipboard}" Click="MenuItemCopyTaskPath_Click" Foreground="{DynamicResource AppText}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid Margin="1,1" ColumnDefinitions="Auto,*,Auto">
                                    <Image Grid.Column="0" Source="{Binding Info.Thumbnail}" MaxHeight="74" />
                                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Info.Title, StringFormat='Title: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource AppText}"></TextBlock>
                                        <TextBlock Text="{Binding TaskType, StringFormat='Task Type: {0}'}" Foreground="{DynamicResource AppText}"></TextBlock>
                                        <TextBlock Text="{Binding DisplayStatus, StringFormat='Status: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource AppText}" />
                                        <StackPanel Orientation="Horizontal" Margin="1,1,0,1">
                                            <Button Content="{loc:Loc TaskCancel}" Margin="0,0,4,0" MinWidth="60" Height="28" FontSize="12" Click="BtnCancelTask_Click" IsVisible="{Binding CanCancel}" Background="{DynamicResource ActionButtonBackground}" Foreground="{DynamicResource ActionButtonText}" BorderBrush="{DynamicResource ActionButtonBorder}" />
                                            <Button Content="{loc:Loc TaskRetry}" Margin="0,0,4,0" MinWidth="60" Height="28" FontSize="12" Click="BtnRetryTask_Click" IsVisible="{Binding CanReinitialize}" Background="{DynamicResource ActionButtonBackground}" Foreground="{DynamicResource ActionButtonText}" BorderBrush="{DynamicResource ActionButtonBorder}" />
                                            <Button Content="{loc:Loc TaskErrorButton}" Margin="0,0,4,0" MinWidth="60" Height="28" FontSize="12" Click="BtnTaskError_Click" IsVisible="{Binding Exception, Converter={StaticResource NullToBool}}" Background="{DynamicResource ActionButtonBackground}" Foreground="{DynamicResource ActionButtonText}" BorderBrush="{DynamicResource ActionButtonBorder}" />
                                            <ProgressBar Height="16" Width="200" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" HorizontalAlignment="Left" Background="{DynamicResource AppElementInnerBackground}" Foreground="{DynamicResource ProgressBarForeground}" />
                                            <Image MaxHeight="20" Margin="5,0" Source="{Binding StatusImage, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Padding="0" VerticalAlignment="Top" Width="22" Height="22" Margin="0,0,2,0" Click="BtnMoveTaskUp_Click" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}">
                                            <TextBlock Text="&#x25B2;" Foreground="{DynamicResource AppTextDisabled}" />
                                        </Button>
                                        <Button Padding="0" VerticalAlignment="Top" Width="22" Height="22" Margin="0,0,2,0" Click="BtnMoveTaskDown_Click" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}">
                                            <TextBlock Text="&#x25BC;" Foreground="{DynamicResource AppTextDisabled}" />
                                        </Button>
                                        <Button Padding="3" VerticalAlignment="Top" Width="22" Height="22" Click="BtnRemoveTask_Click" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}">
                                            <TextBlock Text="&#x2715;" Foreground="{DynamicResource AppTextDisabled}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Column="4" Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="$" FontWeight="Bold" FontSize="14" x:Name="btnDonate" ToolTip.Tip="{loc:Loc DonateTooltip}" Height="26" Width="40" Click="btnDonate_Click" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}" Foreground="{DynamicResource AppText}" />
                <Button x:Name="btnSettings" Height="26" Width="40" Margin="4,0,5,0" Click="btnSettings_Click" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}" Foreground="{DynamicResource AppText}">
                    <TextBlock Text="&#x2699;" FontSize="16" />
                </Button>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{loc:Loc ParallelTaskLimits}" HorizontalAlignment="Center" Margin="0,10,0,0" FontWeight="Bold" MinWidth="180" TextAlignment="Center" Foreground="{DynamicResource AppDividerText}"/>
                <Separator Margin="0,4,0,0" Background="{DynamicResource AppDivider}" />
                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{loc:Loc VodDownloads}" Margin="0,6,0,0" Foreground="{DynamicResource AppText}" TextWrapping="Wrap" />
                    <NumericUpDown Margin="5,0,0,0" Value="1" Minimum="1" Name="numVod" Width="90" ValueChanged="numVod_ValueChanged" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}" Foreground="{DynamicResource AppText}" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{loc:Loc ClipDownloads}" Margin="0,6,0,0" Foreground="{DynamicResource AppText}" TextWrapping="Wrap" />
                    <NumericUpDown Margin="5,0,0,0" Value="1" Minimum="1" x:Name="numClip" Width="90" ValueChanged="numClip_ValueChanged" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}" Foreground="{DynamicResource AppText}" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{loc:Loc ChatDownloads}" Margin="0,6,0,0" Foreground="{DynamicResource AppText}" TextWrapping="Wrap" />
                    <NumericUpDown Margin="5,0,0,0" Value="1" Minimum="1" x:Name="numChat" Width="90" ValueChanged="numChat_ValueChanged" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}" Foreground="{DynamicResource AppText}" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{loc:Loc ChatRenders}" Margin="0,6,0,0" Foreground="{DynamicResource AppText}" TextWrapping="Wrap" />
                    <NumericUpDown Margin="5,0,0,0" Value="1" Minimum="1" x:Name="numRender" Width="90" ValueChanged="numRender_ValueChanged" Background="{DynamicResource AppElementBackground}" BorderBrush="{DynamicResource AppElementBorder}" Foreground="{DynamicResource AppText}" />
                </WrapPanel>
                <TextBlock Text="{loc:Loc MassDownloads}" HorizontalAlignment="Center" Margin="0,10,0,0" FontWeight="Bold" MinWidth="180" TextAlignment="Center" Foreground="{DynamicResource AppDividerText}"/>
                <Separator Margin="0,4,0,0" Background="{DynamicResource AppDivider}" />
                <Button x:Name="btnUrlList" Content="{loc:Loc UrlList}" Margin="0,11,0,0" Width="165" Click="btnUrlList_Click" Background="{DynamicResource ActionButtonBackground}" Foreground="{DynamicResource ActionButtonText}" BorderBrush="{DynamicResource ActionButtonBorder}"/>
                <Button x:Name="btnVods" Content="{loc:Loc SearchVods}" Margin="0,8,0,0" Width="165" Click="btnVods_Click" Background="{DynamicResource ActionButtonBackground}" Foreground="{DynamicResource ActionButtonText}" BorderBrush="{DynamicResource ActionButtonBorder}"/>
                <Button x:Name="btnClips" Content="{loc:Loc SearchClips}" Margin="0,8,0,0" Width="165" Click="btnClips_Click" Background="{DynamicResource ActionButtonBackground}" Foreground="{DynamicResource ActionButtonText}" BorderBrush="{DynamicResource ActionButtonBorder}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
